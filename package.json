{
  "name": "youtubemytube",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "YouTube content blocker",
  "scripts": {
    "build": "node esbuild.config.mjs all",
    "build:chrome": "node esbuild.config.mjs chrome",
    "build:firefox": "node esbuild.config.mjs firefox",
    "check": "biome check . && bun run typecheck && bun run build:firefox && bun run lint:webext",
    "check:fix": "biome check --write .",
    "clean": "rm -rf dist node_modules bun.lock",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "hooks:install": "node scripts/install-hooks.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "lint": "biome lint .",
    "lint:webext": "bunx web-ext lint --source-dir dist/firefox",
    "prepare": "node scripts/install-hooks.mjs",
    "release": "cog bump --auto",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "update": "bun update --latest",
    "watch": "node esbuild.config.mjs all --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.0",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.28.2",
    "lefthook": "2.1.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
