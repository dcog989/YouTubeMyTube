{
  "name": "youtube-blocker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "YouTube content blocker",
  "scripts": {
    "build": "node esbuild.config.mjs all",
    "build:chrome": "node esbuild.config.mjs chrome",
    "build:firefox": "node esbuild.config.mjs firefox",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "clean": "rm -rf dist node_modules bun.lock",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "hooks:install": "lefthook install",
    "icons": "node scripts/gen-icons.mjs",
    "lint": "biome lint .",
    "prepare": "lefthook install",
    "release": "cog bump --auto",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "update": "bun update --latest",
    "watch": "node esbuild.config.mjs all --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/chrome": "^0.3.0",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/node": "^26.6.1",
    "esbuild": "^0.28.2",
    "lefthook": "2.1.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
