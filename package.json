{
  "name": "youtubemytube",
  "version": "0.18.0",
  "private": true,
  "type": "module",
  "description": "YouTube content blocker",
  "scripts": {
    "build": "node esbuild.config.mjs all",
    "build:chrome": "node esbuild.config.mjs chrome",
    "build:firefox": "node esbuild.config.mjs firefox",
    "check": "biome check . && bun run typecheck && bun run test && bun run build:firefox && bun run lint:webext",
    "fix": "biome check --write .",
    "clean": "rm -rf dist node_modules bun.lock",
    "hooks:install": "node scripts/install-hooks.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "lint:webext": "bunx web-ext lint --source-dir dist/firefox",
    "prepare": "node scripts/install-hooks.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "bun --check",
    "typecheck:watch": "bun --watch --check",
    "update": "bun update --latest",
    "watch": "node esbuild.config.mjs all --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "lefthook": "2.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
